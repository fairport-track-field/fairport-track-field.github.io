---
layout: base.njk
description: "Varsity standards and NYSPHSAA state qualifying standards for Fairport High School indoor track and field, boys and girls."
title: Varsity and state standards
permalink: /standards/
---
<div class="wrap wrap--narrow">
  <h1 class="page-title">Standards</h1>
  <h2 class="section-title">Varsity standards</h2>
  <p class="page-lede">{{ standards.note }}</p>
  <table class="standards">
    <thead><tr><th scope="col">Girls</th><th scope="col">Event</th><th scope="col">Boys</th></tr></thead>
    <tbody>
      {% for row in standards.events %}
      <tr>
        <td class="standards__mark">{{ row.girls }}</td>
        <th scope="row" class="standards__event">{{ row.event }}</th>
        <td class="standards__mark">{{ row.boys }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if standards.state %}
  <h2 class="section-title standards__state-title" id="state">{{ standards.state.title }}</h2>
  <p class="page-lede">{{ standards.state.note }}</p>
  <table class="standards">
    <thead><tr><th scope="col">Girls</th><th scope="col">Event</th><th scope="col">Boys</th></tr></thead>
    <tbody>
      {% for row in standards.state.events %}
      <tr>
        <td class="standards__mark">{{ row.girls }}</td>
        <th scope="row" class="standards__event">{{ row.event }}</th>
        <td class="standards__mark">{{ row.boys }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
