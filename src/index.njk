---
layout: base.njk
permalink: /
---
{%- set ns = { next: schedule.meets | nextMeet(buildDate) } -%}

<section class="hero" aria-labelledby="next-meet-name">
  <div class="hero__lanes" aria-hidden="true">{% for n in range(1, 7) %}<span>{{ n }}</span>{% endfor %}</div>
  <div class="wrap hero__inner" id="next-meet"
       data-meets='{{ schedule.meets | dump | safe }}'>
    {% if ns.next %}
      <p class="hero__kicker">Next meet<span class="hero__countdown" data-countdown></span></p>
      <h1 class="hero__meet" id="next-meet-name" data-field="name">{{ ns.next.name }}</h1>
      <p class="hero__when">
        <span data-field="date">{{ ns.next.date | dateRange(ns.next.end_date) }}</span>
        <span class="hero__where" data-field="where">{{ ns.next.location }}{% if ns.next.time %}, {{ ns.next.time }}{% endif %}</span>
      </p>
      <p class="hero__links"><a class="button button--light" href="/schedule/">Full {{ schedule.season | lower }} schedule</a></p>
    {% else %}
      <p class="hero__kicker">Season complete</p>
      <h1 class="hero__meet" id="next-meet-name">Thanks for a great {{ schedule.season }} season</h1>
      <p class="hero__links"><a class="button button--light" href="/schedule/">See every result</a></p>
    {% endif %}
  </div>
</section>

<div class="wrap home-grid">
  <section class="home-news" aria-labelledby="news-heading">
    <h2 id="news-heading" class="section-title">Hi Brittany</h2>
    {% for post in collections.posts | head(3) %}
      <article class="teaser">
        <h3 class="teaser__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="teaser__date"><time datetime="{{ post.date | isoDate }}">{{ post.date | longDate }}</time></p>
        <p>{{ post.content | excerpt }}</p>
      </article>
    {% else %}
      <p class="empty">No posts yet.</p>
    {% endfor %}
    <p><a href="/news/">All news</a></p>
  </section>

  <section class="home-recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="section-title">The {{ rankings.currentYear | seasonLabel }} season in the record book</h2>
    <p class="home-recent__lede">
      <strong class="big-number">{{ rankings.recent.length }}</strong>
      marks from last season are on Fairport's all-time top 10 lists.
    </p>
    <ul class="recent-list">
      {% for entry in rankings.recent | head(8) %}
        <li>
          <span class="recent-list__rank">{{ "T" if entry.tied }}{{ entry.rank }}</span>
          <span class="recent-list__who">{{ entry.athletes or entry.meet or "Relay" }}</span>
          <span class="recent-list__what">{{ entry.gender | capitalize }} {{ entry.eventLabel }}, {{ entry.mark }}</span>
        </li>
      {% endfor %}
    </ul>
    <p><a href="/top-10/">See every top 10 list</a></p>
  </section>
</div>
