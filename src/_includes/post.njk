---
layout: base.njk
---
<article class="wrap wrap--text post">
  <p class="post__back"><a href="/news/">All news</a></p>
  <h1 class="page-title">{{ title }}</h1>
  <p class="post__meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time>{% if author %}, by {{ author }}{% endif %}</p>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
