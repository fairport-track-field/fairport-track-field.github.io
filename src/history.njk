---
layout: base.njk
description: "Fairport Red Raiders indoor track and field history at the Section V sectional championships: team finishes, sectional champions and every scoring performance."
title: Championship history
permalink: /history/
---
{% set S = sectionalStats %}
<div class="wrap">
  <h1 class="page-title">Championship history</h1>
  <p class="page-lede">How Fairport has done at the Section V indoor sectional championships, season by season.</p>

  <section class="sv-alltime" aria-labelledby="sv-title">
    <h2 class="section-title" id="sv-title">Section V all-time top 10</h2>
    <dl class="stat-row">
      <div><dt>Fairport marks in the Section V all-time top 10</dt><dd>{{ sv_alltime.total }}</dd></div>
      <div><dt>Girls</dt><dd>{{ sv_alltime.girls }}</dd></div>
      <div><dt>Boys</dt><dd>{{ sv_alltime.boys }}</dd></div>
      <div><dt>#1 all-time</dt><dd>{{ sv_alltime.number_ones | length }}</dd></div>
    </dl>
    <p>Fairport athletes and relays hold {{ sv_alltime.total }} of the top-10 marks in Section V indoor history, across {{ sv_alltime.events }} events. The #1 marks: {% for x in sv_alltime.number_ones %}{{ x }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
    <p class="muted">Source: <a href="{{ sv_alltime.source_url }}">{{ sv_alltime.source }}</a>, as of {{ sv_alltime.as_of | longDate }}.</p>
  </section>

  <section class="sect-summary" aria-labelledby="sect-title">
    <h2 class="section-title" id="sect-title">Section V sectionals</h2>

    <dl class="stat-row">
      {% if S.totals.teamTitles %}<div><dt>Team sectional titles</dt><dd>{{ S.totals.teamTitles }}</dd></div>{% endif %}
      <div><dt>Individual &amp; relay titles</dt><dd>{{ S.totals.titles }}</dd></div>
      <div><dt>Top-6 scoring finishes</dt><dd>{{ S.totals.scorers }}</dd></div>
      <div><dt>Seasons on file</dt><dd>{{ S.totals.seasons }}</dd></div>
    </dl>

    <div class="table-scroll">
    <table class="history sect-table">
      <thead>
        <tr>
          <th scope="col">Season</th>
          <th scope="col">Meet</th>
          <th scope="col">Girls team</th>
          <th scope="col">Boys team</th>
          <th scope="col">Titles</th>
          <th scope="col">Scorers</th>
        </tr>
      </thead>
      <tbody>
        {% for s in S.seasons %}
        <tr>
          <th scope="row"><a href="#season-{{ s.year }}">{{ s.year | seasonLabel }}</a></th>
          <td>{{ s.meet }}</td>
          {% for g in ["girls", "boys"] %}
          {% set t = s.byGender[g].team %}
          <td class="history__place{% if t and t.place == 1 %} is-team-title{% endif %}">{% if t %}{% if t.place == 1 %}{% if t.shared_with %}Co-champions{% else %}Champions{% endif %}, {% else %}{{ t.place | ordinal }}, {% endif %}{{ t.points | pts }} pts{% else %}<span class="muted">Not on file</span>{% endif %}</td>
          {% endfor %}
          <td class="num">{{ s.byGender.girls.champions.length + s.byGender.boys.champions.length }}</td>
          <td class="num">{{ s.byGender.girls.scorers.length + s.byGender.boys.scorers.length }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% if S.teamTitles.length %}
    <p class="team-titles">{% for t in S.teamTitles %}<strong>{{ t.year | seasonLabel }} {{ t.gender }}:</strong> {{ t.meet }} team {% if t.shared_with %}co-champions with {{ t.shared_with }}{% else %}champions{% endif %} ({{ t.points | pts }} points){% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {% endif %}
    <p class="history__note">Team places are from the official team scores. "Not on file" means the team scores for that season weren't available online. Scorers are top-6 finishes (scored 10-8-6-4-2-1).</p>
  </section>

  <section aria-labelledby="champs-title">
    <h2 class="section-title" id="champs-title">Fairport sectional champions</h2>
    <div class="table-scroll">
    <table class="history champs-table">
      <thead><tr><th scope="col">Season</th><th scope="col">Event</th><th scope="col">Champion</th><th scope="col">Mark</th></tr></thead>
      <tbody>
        {% for c in S.champions %}
        <tr>
          <td>{{ c.year | seasonLabel }}</td>
          <td>{{ c.gender | capitalize }} {{ c.label }}</td>
          <th scope="row">{{ c.who }}</th>
          <td class="num">{{ c.mark }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </section>

  <div class="sect-leaders">
    {% if S.multiChampions.length %}
    <section aria-labelledby="multi-title">
      <h2 class="section-title" id="multi-title">Multiple-time champions</h2>
      <ul class="leader-list">
        {% for a in S.multiChampions %}
        <li><strong>{{ a.athlete }}</strong> <span class="leader-list__count">{{ a.titles.length }} titles</span><span class="leader-list__detail">{{ a.titles | join(", ") }}</span></li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    <section aria-labelledby="event-title">
      <h2 class="section-title" id="event-title">Titles by event</h2>
      <table class="history event-titles">
        <thead><tr><th scope="col">Event</th><th scope="col">Girls</th><th scope="col">Boys</th></tr></thead>
        <tbody>
          {% for e in S.eventTitles %}
          <tr><th scope="row">{{ e.label }}</th><td class="num">{{ e.girls or "–" }}</td><td class="num">{{ e.boys or "–" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  </div>

  <section aria-labelledby="seasons-title">
    <h2 class="section-title" id="seasons-title">Every season</h2>
    {% for s in S.seasons %}
    <details class="season-detail" id="season-{{ s.year }}">
      <summary>
        <span class="season-detail__year">{{ s.year | seasonLabel }}</span>
        <span class="season-detail__meta">{{ s.meet }}, {{ s.venue }}</span>
      </summary>
      <div class="season-detail__body">
        {% for g in ["girls", "boys"] %}
        {% set G = s.byGender[g] %}
        <div class="season-detail__col">
          <h3 class="toplist__title">{{ g | capitalize }}{% if G.team %}: {{ G.team.place | ordinal }} place, {{ G.team.points | pts }} points <span class="muted">({% if G.team.place == 1 %}{% if G.team.shared_with %}team title shared with {{ G.team.shared_with }}{% else %}team champions{% endif %}{% else %}won by {{ G.team.winner }}, {{ G.team.winner_points | pts }}{% endif %})</span>{% endif %}</h3>
          {% if G.resultsMissing %}<p class="muted">Individual results for this season aren't on file yet.</p>{% else %}
          <table class="toplist__table season-results">
            <thead class="visually-hidden"><tr><th>Place</th><th>Event</th><th>Athlete</th><th>Mark</th></tr></thead>
            <tbody>
            {% for r in G.results %}
              <tr{% if r.place == 1 %} class="is-champ"{% elif r.points %} class="is-scorer"{% endif %}>
                <td class="toplist__rank">{{ r.place if r.place else "–" }}</td>
                <td>{{ r.label }}</td>
                <td class="toplist__who">{{ r.athlete or "Relay" }}</td>
                <td class="toplist__mark">{{ r.mark }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <p class="history__note">Source: {% if s.source.startsWith("http") %}<a href="{{ s.source }}">MileSplit results</a>{% else %}{{ s.source }}{% endif %}. Highlighted rows scored points for the team.</p>
    </details>
    {% endfor %}
  </section>

  {% if S.missing.length or S.partial.length %}
  <div class="empty-state coverage">
    {% if S.missing.length %}<p><strong>Seasons still to add:</strong> {% for y in S.missing %}{{ y | seasonLabel }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
    {% if S.partial.length %}<p><strong>Partial seasons:</strong> {% for x in S.partial %}{{ x.year | seasonLabel }} {{ x.gender }} results{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
    <p>To fill a gap, add its results to <code>src/_data/sectionals.json</code>, or send the results file and they'll be added. (There was no 2020–21 sectional meet.)</p>
  </div>
  {% endif %}

  {% set others = championships.results | sort(true, false, "year") | groupBy("year") %}
  {% if others.length %}
  <section aria-labelledby="other-title">
    <h2 class="section-title" id="other-title">Other championship meets</h2>
    {% for season in others %}
    <h3 class="toplist__title">{{ season.name | seasonLabel }}</h3>
    <div class="table-scroll">
    <table class="history">
      <thead><tr><th scope="col">Meet</th><th scope="col">Girls</th><th scope="col">Boys</th><th scope="col">Champions</th></tr></thead>
      <tbody>
      {% for r in season.items %}
        <tr>
          <th scope="row">{{ r.meet }}</th>
          <td class="history__place">{{ r.girls or "—" }}</td>
          <td class="history__place">{{ r.boys or "—" }}</td>
          <td>
            {% if r.champions and r.champions.length %}
            <ul class="champions">
              {% for c in r.champions %}<li><strong>{{ c.athlete }}</strong>, {{ c.gender }} {{ c.event }}{% if c.mark %} ({{ c.mark }}){% endif %}</li>{% endfor %}
            </ul>
            {% endif %}
            {% if r.notes %}<p class="history__note">{{ r.notes }}</p>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endfor %}
  </section>
  {% endif %}
</div>
