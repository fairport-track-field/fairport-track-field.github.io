<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " | " + site.title + ", Fairport NY") if title else site.search_title -%}
  {%- set pageDesc = description or site.description -%}
  {%- set pageUrl = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ site.url }}/assets/mascot.png">
  <meta property="og:image:alt" content="Fairport Red Raiders mascot">
  {%- if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": "Fairport Red Raiders Track & Field",
    "alternateName": ["Fairport Track and Field", "Fairport High School Track"],
    "sport": "Track and field",
    "url": "{{ site.url }}/",
    "memberOf": { "@type": "HighSchool", "name": "{{ site.school }}", "address": { "@type": "PostalAddress", "addressLocality": "Fairport", "addressRegion": "NY", "addressCountry": "US" } }
  }
  </script>
  {%- endif %}
  <link rel="preload" href="/assets/fonts/big-shoulders-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body class="page-{{ page.fileSlug or 'home' }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="wordmark" href="/">
        <img class="wordmark__logo" src="/assets/mascot.png" alt="" width="159" height="147">
        <span class="wordmark__text">
        <span class="wordmark__town">Fairport</span>
        <span class="wordmark__sport">Track &amp; Field</span>
        </span>
      </a>
      <nav class="nav" aria-label="Main">
        {% set links = [
          ["/news/", "News"],
          ["/schedule/", "Schedule & results"],
          ["/records/", "School records"],
          ["/top-10/", "Top 10"],
          ["/standards/", "Standards"],
          ["/history/", "Championship history"]
        ] %}
        {% for link in links %}
          <a href="{{ link[0] }}"{% if page.url == link[0] or (link[0] == '/news/' and page.url.startsWith('/news/')) %} aria-current="page"{% endif %}>{{ link[1] }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="footer__name">Fairport Red Raiders Track &amp; Field</p>
      <p>Fairport High School, Fairport, New York. Meet results are timed and posted by {{ site.results_provider }}{% if site.results_home %} — <a href="{{ site.results_home }}">see all results</a>{% endif %}.</p>
      {% if site.instagram or site.contact_email %}
      <p>
        {% if site.instagram %}<a href="{{ site.instagram }}">Instagram</a>{% endif %}
        {% if site.contact_email %}<a href="mailto:{{ site.contact_email }}">Contact the coaches</a>{% endif %}
      </p>
      {% endif %}
    </div>
  </footer>
  <script src="/assets/site.js" defer></script>
</body>
</html>
